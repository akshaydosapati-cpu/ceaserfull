CEASER_ENV=production
CEASER_APP_URL=https://heyceaser.in/console
CEASER_API_URL=https://ceaser-backend-production-ur04.onrender.com
CEASER_ACCESS_TOKEN=

# Voice behavior. Production installers intentionally do not embed provider
# credentials; keyed STT providers must be brokered by the backend.
CEASER_STT_PROVIDER=google
CEASER_STT_LANGUAGE=en-IN
CEASER_STT_GOOGLE_FALLBACK=true
CEASER_STT_DEEPGRAM_FALLBACK=true
CEASER_DEEPGRAM_STT_MODE=live
CEASER_END_SILENCE_MS=750
CEASER_MAX_COMMAND_SECONDS=12
# Disabled by default because simulated volume-key ducking can change volume
# even when no media is playing. Enable only when explicitly desired.
CEASER_MEDIA_DUCK_ENABLED=true
# Installed default is CommandOrControl+Shift+Space. Local npm start uses
# CommandOrControl+Alt+Space to avoid colliding with an installed CEASER copy.
CEASER_VOICE_HOTKEY=CommandOrControl+Shift+Space

# Google Cloud language services (local development uses Application Default
# Credentials; never package a service-account JSON file in the installer).
GOOGLE_CLOUD_PROJECT=clinilocker-dc25e
CEASER_GOOGLE_STT_PRIMARY_LANGUAGE=en-IN
CEASER_GOOGLE_STT_ALTERNATIVE_LANGUAGES=te-IN,hi-IN,ta-IN,kn-IN
CEASER_TRANSLATION_PROVIDER=
CEASER_TRANSLATION_TARGET_LANGUAGE=en
CEASER_TTS_PROVIDER=elevenlabs
CEASER_TTS_LANGUAGE=auto
CEASER_TTS_STREAMING=true
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_SECONDS=18
# Optional local root for Bolt projects. Defaults to the current user's CEASER Projects folder.
CEASER_PROJECTS_ROOT=

# The companion opens the hosted CEASER console for cloud features.
CEASER_BROWSER_MAX_STEPS=25
CEASER_BROWSER_ACTION_TIMEOUT_SECONDS=15
CEASER_BROWSER_NAVIGATION_TIMEOUT_SECONDS=30
CEASER_WAKE_WORD_ENABLED=false
